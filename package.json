{
  "name": "skyfeed",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:hooks": "node --test .claude/hooks/*.test.mjs",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "stack:smoke": "bash scripts/smoke.sh",
    "e2e": "pnpm --filter @skyfeed/web e2e",
    "drill": "bash scripts/drill.sh",
    "verify": "bash scripts/verify.sh",
    "verify:fast": "bash scripts/verify.sh --fast",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}
