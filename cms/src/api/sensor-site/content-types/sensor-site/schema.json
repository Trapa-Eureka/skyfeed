{
  "kind": "collectionType",
  "collectionName": "sensor_sites",
  "info": {
    "singularName": "sensor-site",
    "pluralName": "sensor-sites",
    "displayName": "Sensor site",
    "description": "What people need to know about the place a sensor stands at"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "sensorId": { "type": "string", "required": true, "unique": true, "regex": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "name": { "type": "string", "required": true, "maxLength": 120 },
    "location": { "type": "string", "maxLength": 160 },
    "notes": { "type": "text", "maxLength": 600 }
  }
}
