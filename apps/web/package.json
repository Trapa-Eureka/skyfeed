{
  "name": "@skyfeed/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operator console: live aircraft map, sensor panel, data age and connection state",
  "scripts": {
    "map-worker": "node scripts/copy-map-worker.mjs",
    "dev": "pnpm map-worker && next dev --port 3000",
    "build": "pnpm map-worker && next build",
    "start": "next start --port 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "demo": "node demo/record.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
