# Copy to .env to override. Every line is optional; the values shown are the defaults.

# Host ports (all bound to 127.0.0.1)
KAFKA_PORT=19092
MQTT_PORT=11883
POSTGRES_PORT=15432
REPLAY_PORT=18090
INGEST_PORT=8081

# Local database password
POSTGRES_PASSWORD=skyfeed

# Simulator
SIM_INTERVAL_MS=2000
SIM_SEED=skyfeed
REPLAY_SPEED=1

# ADS-B source of the ingest service: replay (recorded data) or opensky (the live API, costs credits)
ADSB_SOURCE=replay
ADSB_POLL_INTERVAL=10s
# Credits ingest may spend per UTC day in opensky mode
OPENSKY_DAILY_CREDIT_BUDGET=300
