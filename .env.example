# Copy to .env to override. Every line is optional; the values shown are the defaults.

# Host ports (all bound to 127.0.0.1)
KAFKA_PORT=19092
MQTT_PORT=11883
POSTGRES_PORT=15432
REPLAY_PORT=18090
INGEST_PORT=8081
API_PORT=8080
GATEWAY_PORT=8082
WEB_PORT=3000
# If you change MCP_PORT, change the URL in .mcp.json to match.
MCP_PORT=8083

# Local database password
POSTGRES_PASSWORD=skyfeed

# Simulator
SIM_INTERVAL_MS=2000
SIM_SEED=skyfeed
REPLAY_SPEED=1

# ADS-B source of the ingest service: replay (recorded data) or opensky (the live API, costs credits)
ADSB_SOURCE=replay
ADSB_POLL_INTERVAL=10s
# Credits ingest may spend per UTC day in opensky mode
OPENSKY_DAILY_CREDIT_BUDGET=300

# Background map of the console: a MapLibre style URL, or "none" for a plain grid that needs no network
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
